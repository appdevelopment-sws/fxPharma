generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// 1. SYSTEM CONFIGURATION & FEATURES (GLOBAL)
//////////////////////////////////////////////////////

model Feature {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  module      String?

  organizations OrganizationFeature[]
  plans         PlanFeature[]

  createdAt DateTime @default(now())
}

model Plan {
  id               String  @id @default(cuid())
  key              String  @unique // e.g., "BASIC_MONTHLY"
  name             String
  shortDescription String? @map("short_description")
  description      Json? // Array of strings (points)

  price          Decimal      @default(0.0)
  currency       String       @default("INR")
  billingCycle   BillingCycle @default(MONTHLY) @map("billing_cycle")
  durationDays   Int          @default(30) @map("duration_days")
  priceBreakdown Json?        @map("price_breakdown") // Base, Tax, etc.

  // Limits
  maxStaff     Int @default(1) @map("max_staff")
  maxBranches  Int @default(1) @map("max_branches")
  storageLimit Int @default(1024) @map("storage_limit") // In MB

  // Feature Toggles (JSON for flexible advanced features)
  // e.g., { "apiAccess": true, "whiteLabeling": false, "prioritySupport": true }
  advancedFeatures Json? @map("advanced_features")

  // UI/Landing Page Helpers
  isPopular Boolean @default(false) @map("is_popular")
  badgeText String? @map("badge_text") // e.g., "Best Value"
  status    Int     @default(1) // 1=Active, 0=Inactive

  // Relations
  features      PlanFeature[]
  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model PlanFeature {
  id        String @id @default(cuid())
  planId    String
  featureId String
  config    Json? // Default config for this feature in this plan

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model OrganizationFeature {
  id             String  @id @default(cuid())
  organizationId String
  featureId      String
  enabled        Boolean @default(true)
  config         Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureId])
}

//////////////////////////////////////////////////////
// 2. MULTI-TENANCY ROOT (ORGANIZATIONS & BRANCHES)
//////////////////////////////////////////////////////

model Organization {
  id          String  @id @default(cuid())
  storeName   String  @map("store_name")
  description String?
  category    String?
  logo        String?

  //status
  status OrganizationStatus @default(ACTIVE)

  // Owner Details
  // ownerFirstName String @map("owner_first_name")
  // ownerLastName  String @map("owner_last_name")
  // ownerEmail     String @map("owner_email")
  // ownerPhone     String @map("owner_phone")

  // // Credentials & Licenses
  // loginEmail String  @map("login_email")
  // password   String
  gstNo     String? @map("gst_no")
  licenseNo String? @map("license_no")

  // Address & Location
  streetAddress String @map("street_address")
  city          String
  state         String @map("state_province")
  zipCode       String @map("zip_code")
  country       String

  // Regional Settings
  timezone String?
  currency String? @default("INR")

  type OrganizationType @default(PHARMACY)

  branches  Branch[]
  features  OrganizationFeature[]
  suppliers Supplier[]
  inventory Inventory[]

  // Owner Relation
  ownerId String? @map("owner_id")
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

enum OrganizationType {
  PHARMACY
  WHOLESALE
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCK
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  address String?
  status  Int     @default(1)

  // Assignments scoped to this branch
  userRoles       UserRole[]
  userWorkflows   UserWorkflow[]
  userPermissions UserPermission[]
  inventory       Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

//////////////////////////////////////////////////////
// 3. IDENTITY & RBAC SYSTEM (GLOBAL/CROSS-TENANT)
//////////////////////////////////////////////////////

model User {
  id        String  @id @default(cuid())
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  name      String?
  email     String  @unique
  password  String // Hashed password
  mobile    String? @unique
  regNo     String? @unique @map("reg_no")
  status    Int     @default(1) // 1=Active, 0=Inactive

  // 2FA (Fortify-style)
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorConfirmedAt DateTime? @map("two_factor_confirmed_at")

  lastLogin DateTime? @map("last_login")

  // RBAC & Workflow Assignments
  roles       UserRole[]
  workflows   UserWorkflow[]
  permissions UserPermission[]

  // Organizations owned by this user
  ownedOrganizations Organization[] @relation("OrganizationOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Role {
  id    String  @id @default(cuid())
  key   String  @unique // e.g., 'super_admin', 'pharmacy_admin'
  name  String? // Human readable name
  level Int     @default(0) // Hierarchy level (higher = more power)

  scopeType String  @default("global") @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id") // Optional specific scope

  permissions RolePermission[]
  workflows   RoleWorkflow[]
  userRoles   UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g., 'users.create'
  module String // Grouping (e.g., 'Admissions', 'Inventory')

  workflowPermissions WorkflowPermission[]
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  permissions   WorkflowPermission[]
  roles         RoleWorkflow[]
  userWorkflows UserWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relation Tables for RBAC
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RoleWorkflow {
  id         String @id @default(cuid())
  roleId     String
  workflowId String

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([roleId, workflowId])
}

model WorkflowPermission {
  id           String @id @default(cuid())
  workflowId   String
  permissionId String

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workflowId, permissionId])
}

//////////////////////////////////////////////////////
// 4. TENANT ASSIGNMENTS (SCOPING USERS TO BRANCHES)
//////////////////////////////////////////////////////

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  @@unique([userId, roleId, scopeId])
}

model UserWorkflow {
  id         String @id @default(cuid())
  userId     String
  workflowId String

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id])
  branchId String?

  @@unique([userId, workflowId, scopeId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true) // true = grant, false = revoke override

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id])
  branchId   String?

  @@unique([userId, permissionId, scopeId])
}

model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Float
  taxType   TaxType  @default(Exclusive) @map("tax_type")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hsnMappings HsnMapping[]
}

enum TaxType {
  Exclusive
  Inclusive
}

model Hsn {
  id          String   @id @default(cuid())
  hsncode     String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hsnMappings HsnMapping[]
  masterProducts MasterProduct[]
}

model HsnMapping {
  id        String   @id @default(cuid())
  hsnid     String
  taxid     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hsn Hsn @relation(fields: [hsnid], references: [id], onDelete: Cascade)
  tax Tax @relation(fields: [taxid], references: [id], onDelete: Cascade)

  @@unique([hsnid, taxid])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  masterProducts MasterProduct[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  // Self-relation for hierarchy
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  masterProducts MasterProduct[]
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterProducts MasterProduct[]
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  companyName           String   @map("company_name")
  gstNumber             String   @map("gst_number")
  officeAddress         String   @map("office_address")
  registrationDocuments String?  @map("registration_documents")

  // Contact Details
  contactPersonName     String   @map("contact_person_name")
  email                 String   @map("email")
  phone                 String   @map("phone")
  whatsappNumber        String   @map("whatsapp_number")

  // Preferences & Automation
  isPreferred           Boolean  @default(false) @map("is_preferred")
  autoGeneratePO        Boolean  @default(false) @map("auto_generate_po")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Salt {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MasterProduct {
  id              String  @id @default(cuid())
  name            String
  industrySegment String? @default("1") @map("industry_segment")
  imageUrl        String? @map("image_url")

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  brandId String? @map("brand_id")
  brand   Brand?  @relation(fields: [brandId], references: [id])

  manufacturerId String?       @map("manufacturer_id")
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])

  salt String?

  hsnId String? @map("hsn_id")
  hsn   Hsn?    @relation(fields: [hsnId], references: [id])

  categoryType String? @default("TAB") @map("category_type")
  status       String? @default("CONTINUE")
  colorType    String? @default("NORMAL") @map("color_type")

  isNarcotic   Boolean @default(false) @map("is_narcotic")
  isScheduleH  Boolean @default(false) @map("is_schedule_h")
  isScheduleH1 Boolean @default(false) @map("is_schedule_h1")

  barcodes MasterProductBarcode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  @@index([name])
}

model MasterProductBarcode {
  id              String        @id @default(cuid())
  value           String        @unique
  masterProductId String        @map("master_product_id")
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([value])
}


model Inventory {
  id              String  @id @default(cuid())
  organizationId  String  @map("organization_id")
  branchId        String? @map("branch_id")
  
  // 01 Product Identification
  name            String
  status          InventoryStatus @default(CONTINUE)
  manufacturer    String?
  saltComposition String?  @map("salt_composition")
  category        String?  @default("TAB")

  // 02 Classification & Units
  packing         String?
  unit1st         String?  @map("unit_1st")
  unit2nd         String?  @map("unit_2nd")
  hsnCode         String?  @map("hsn_code")
  itemType        String?  @default("NORMAL") @map("item_type")
  colorType       String?  @default("NORMAL") @map("color_type")
  decimal         String?  @default("No")
  type            String?  @default("NORMAL")

  // 03 Pricing & Taxation
  localTax        String?  @default("Taxable") @map("local_tax")
  centralTax      String?  @default("Taxable") @map("central_tax")
  sgst            Decimal? @default(0.0)
  cgst            Decimal? @default(0.0)
  igst            Decimal? @default(0.0)
  mrp             Decimal? @default(0.0)
  purchaseRate    Decimal? @default(0.0) @map("purchase_rate")
  costPerUnit     Decimal? @default(0.0) @map("cost_per_unit")
  rateA           Decimal? @default(0.0) @map("rate_a")
  rateB           Decimal? @default(0.0) @map("rate_b")
  rateC           Decimal? @default(0.0) @map("rate_c")
  cer             Decimal? @default(0.0)

  // 04 Inventory Thresholds
  minQty          Int?     @default(0) @map("min_qty")
  maxQty          Int?     @default(0) @map("max_qty")
  reorderQty      Int?     @default(0) @map("reorder_qty")
  daysLimit       Int?     @default(0) @map("days_limit")
  convStri        Decimal? @default(0.0) @map("conv_stri")
  convCas         Decimal? @default(0.0) @map("conv_cas")

  // 05 Discounts & Margins
  volumeDiscount  Decimal? @default(0.0) @map("volume_discount")
  itemDiscount    Decimal? @default(0.0) @map("item_discount")
  maxDiscount     Decimal? @default(0.0) @map("max_discount")
  minMargin       Decimal? @default(0.0) @map("min_margin")
  specialDiscount Decimal? @default(0.0) @map("special_discount")
  purchaseDiscount Decimal? @default(0.0) @map("purchase_discount")

  // 06 Regulatory & Product Flags
  isNarcotic      Boolean  @default(false) @map("is_narcotic")
  isScheduleH     Boolean  @default(false) @map("is_schedule_h")
  isScheduleH1    Boolean  @default(false) @map("is_schedule_h1")
  hideProduct     Boolean  @default(false) @map("hide_product")
  negativeStock   Boolean  @default(false) @map("negative_stock")
  editRates       Boolean  @default(true)  @map("edit_rates")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([name])
}

enum InventoryStatus {
  CONTINUE
  DISCONTINUE
}
