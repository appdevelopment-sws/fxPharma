generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// 1. ORGANIZATIONS & BRANCHES (MULTI-TENANCY)
//////////////////////////////////////////////////////

model Organization {
  id      String @id @default(cuid())
  name    String
  status  Int    @default(1) // 1=Active, 0=Inactive

  branches Branch[]
  features OrganizationFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  address        String?
  status         Int          @default(1)

  // Assignments scoped to this branch
  userRoles       UserRole[]
  userWorkflows    UserWorkflow[]
  userPermissions  UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

//////////////////////////////////////////////////////
// 2. AUTHENTICATION (USERS)
//////////////////////////////////////////////////////

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String // Hashed password
  mobile   String?
  regNo    String? @unique @map("reg_no")
  status   Int    @default(1) // 1=Active, 0=Inactive

  // 2FA (Fortify-style)
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorConfirmedAt DateTime? @map("two_factor_confirmed_at")
  
  lastLogin DateTime? @map("last_login")

  // RBAC & Workflow Assignments
  roles       UserRole[]
  workflows   UserWorkflow[]
  permissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

//////////////////////////////////////////////////////
// 3. RBAC & WORKFLOW SYSTEM
//////////////////////////////////////////////////////

model Role {
  id        String  @id @default(cuid())
  key       String  @unique // e.g., 'super_admin', 'pharmacy_admin'
  name      String? // Human readable name
  level     Int     @default(0) // Hierarchy level (higher = more power)
  
  scopeType String  @default("global") @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id") // Optional specific scope

  permissions RolePermission[]
  workflows   RoleWorkflow[]
  userRoles   UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RoleWorkflow {
  id         String @id @default(cuid())
  roleId     String
  workflowId String

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([roleId, workflowId])
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g., 'users.create'
  module String // Grouping (e.g., 'Admissions', 'Inventory')

  workflowPermissions WorkflowPermission[]
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  permissions   WorkflowPermission[]
  roles         RoleWorkflow[]
  userWorkflows UserWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowPermission {
  id           String @id @default(cuid())
  workflowId   String
  permissionId String

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workflowId, permissionId])
}

//////////////////////////////////////////////////////
// 4. ASSIGNMENTS (WITH SCOPING)
//////////////////////////////////////////////////////

model UserRole {
  id        String  @id @default(cuid())
  userId    String
  roleId    String
  
  scopeType String  @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id") // Specific Branch ID if scopeType is 'branch'

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeId])
}

model UserWorkflow {
  id         String  @id @default(cuid())
  userId     String
  workflowId String
  
  scopeType String  @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([userId, workflowId, scopeId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true) // true = grant, false = revoke override

  scopeType String  @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId, scopeId])
}

//////////////////////////////////////////////////////
// 5. FEATURES FLAGS
//////////////////////////////////////////////////////

model Feature {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  module      String?

  organizations OrganizationFeature[]

  createdAt DateTime @default(now())
}

model OrganizationFeature {
  id             String @id @default(cuid())
  organizationId String
  featureId      String
  enabled        Boolean @default(true)
  config         Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureId])
}
