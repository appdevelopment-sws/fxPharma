generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

enum HsnType {
  GOODS
  SERVICE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

//////////////////////////////////////////////////////
// TENANT + RBAC (MULTI-TENANT ISOLATION CORE)
//////////////////////////////////////////////////////

model Tenant {
  id     String       @id @default(cuid())
  name   String
  status TenantStatus @default(ACTIVE)

  users User[]
  roles Role[]

  branches  Branch[]
  products  TenantProduct[]
  suppliers Supplier[]

  subscriptions TenantSubscription[]
  features      TenantFeature[]
  setting       TenantSetting?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name         String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

//////////////////////////////////////////////////////
// GLOBAL MASTER DATA (SHARED ACROSS TENANTS)
//////////////////////////////////////////////////////

model HsnCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String?
  type        HsnType
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenantId String?   // ✅ ADD THIS
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])

  products MasterProduct[]
  taxes    HsnTaxMapping[]
}

model TaxRule {
  id       Int      @id @default(autoincrement())
  name     String?
  rate     Decimal  @db.Decimal(5, 2)
  type     TaxType
  country  String   @default("India")
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())

  hsnMappings HsnTaxMapping[]
}

model HsnTaxMapping {
  id            Int      @id @default(autoincrement())
  hsnCodeId     Int
  taxRuleId     Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  hsnCode HsnCode @relation(fields: [hsnCodeId], references: [id])
  taxRule TaxRule @relation(fields: [taxRuleId], references: [id])

  @@index([hsnCodeId])
  @@index([taxRuleId])
}

model Feature {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?
  module      String?
  isActive    Boolean @default(true)

  plans   PlanFeature[]
  tenants TenantFeature[]
}

model Plan {
  id           Int          @id @default(autoincrement())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle
  maxUsers     Int?
  maxInvoices  Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  features      PlanFeature[]
  subscriptions TenantSubscription[]
}

model PlanFeature {
  id        Int @id @default(autoincrement())
  planId    Int
  featureId Int

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
}

model TenantSubscription {
  id            Int       @id @default(autoincrement())
  tenantId      String
  planId        Int
  startDate     DateTime
  endDate       DateTime?
  status        String
  paymentStatus String
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
}

model TenantFeature {
  id        Int     @id @default(autoincrement())
  tenantId  String
  featureId Int
  enabled   Boolean @default(true)
  config    Json?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
}

model TenantSetting {
  tenantId String @id

  inventoryEnabled Boolean @default(true)
  rackEnabled      Boolean @default(false)
  batchEnabled     Boolean @default(false)
  expiryEnabled    Boolean @default(false)
  gstEnabled       Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Salt {
  id   Int    @id @default(autoincrement())
  name String @unique

  compositions MedicineComposition[]
}

model Company {
  id     Int           @id @default(autoincrement())
  name   String
  gstin  String?       @unique
  status CompanyStatus @default(ACTIVE)
  tenantId String? 
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  products MasterProduct[]
}

model ProductType {
  id        Int    @id @default(autoincrement())
  name      String
  unit_type String
  tenantId String? 
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  products MasterProduct[]
}

model MasterProduct {
  id           Int     @id @default(autoincrement())
  name         String
  generic_name String?
  brand_name   String?
  strength     String?
  pack_size    Int?    
  unit         String? 


  isPrescriptionRequired Boolean @default(false)
  scheduleType           String?

  hsnCodeId Int
  hsnCode   HsnCode @relation(fields: [hsnCodeId], references: [id])

  company_id Int
  company    Company @relation(fields: [company_id], references: [id])

  product_type_id Int
  product_type    ProductType @relation(fields: [product_type_id], references: [id])

  compositions   MedicineComposition[]
  tenantProducts TenantProduct[]

  @@unique([name, strength, company_id])
}

model MedicineComposition {
  id Int @id @default(autoincrement())

  productId Int
  saltId    Int

  strength String

  product MasterProduct @relation(fields: [productId], references: [id])
  salt    Salt          @relation(fields: [saltId], references: [id])

  @@unique([productId, saltId])
}

//////////////////////////////////////////////////////
// TENANT DATA (STRICTLY ISOLATED)
//////////////////////////////////////////////////////

model Branch {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  address String?

  racks     Rack[]
  batches   Batch[]
  sales     Sale[]
  purchases Purchase[]

  @@index([tenantId])
}

model Rack {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  name String

  batches Batch[]
}

model TenantProduct {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  masterProductId Int?
  masterProduct   MasterProduct? @relation(fields: [masterProductId], references: [id])

  name       String
  displayName String? 
  

  hsnCodeId Int?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])


  companyId Int? // ✅ NEW (for custom products)
  company   Company? @relation(fields: [companyId], references: [id])

  barcode    String?

  isActive Boolean @default(true)

  batches       Batch[]
  purchaseItems PurchaseItem[]

  @@index([tenantId])
  @@index([masterProductId])
}

model Batch {
  id String @id @default(cuid())

  tenantProductId String
  tenantProduct   TenantProduct @relation(fields: [tenantProductId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  rackId String?
  rack   Rack?   @relation(fields: [rackId], references: [id])

  batchNumber String
  expiryDate  DateTime

  mrp           Decimal @db.Decimal(10, 2)
  purchasePrice Decimal @db.Decimal(10, 2)
  sellingPrice  Decimal @db.Decimal(10, 2)
  manufacturedAt DateTime?
  isExpired      Boolean @default(false)

  quantity      Int
  freeQuantity  Int            @default(0)
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  stockLedgers  StockLedger[]

  @@unique([batchNumber, tenantProductId, branchId])
}

model Supplier {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String
  phone  String? // ✅ NEW
  email  String? // ✅ NEW
  gstin  String? // ✅ NEW
  address String? // ✅ NEW


  purchases Purchase[]

  @@index([tenantId])
}

//////////////////////////////////////////////////////
// TRANSACTIONS
//////////////////////////////////////////////////////

model Purchase {
  id String @id @default(cuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  totalAmount Decimal @db.Decimal(12, 2)

  items PurchaseItem[]
  status String @default("COMPLETED") // ✅ NEW

}

model PurchaseItem {
  id String @id @default(cuid())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  tenantProductId String
  tenantProduct   TenantProduct @relation(fields: [tenantProductId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  quantity Int
}

model Sale {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  totalAmount Decimal @db.Decimal(12, 2)
  status String @default("COMPLETED") // ✅ NEW

  items SaleItem[]

  createdAt DateTime @default(now())
}

model SaleItem {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  quantity Int
  price    Decimal @db.Decimal(10, 2)
}

//////////////////////////////////////////////////////
// STOCK LEDGER (AUDIT TRAIL)
//////////////////////////////////////////////////////

model StockLedger {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  type StockMovementType
  direction String // ✅ NEW: IN / OUT
  unitCost Decimal? @db.Decimal(10, 2) // ✅ NEW

  quantity    Int
  referenceId String?
  
  referenceType String? // ✅ NEW (SALE / PURCHASE)

  createdAt DateTime @default(now())

  @@index([batchId])
}
