generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// 1. SYSTEM CONFIGURATION & FEATURES (GLOBAL)
//////////////////////////////////////////////////////

model Feature {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  module      String?

  organizations OrganizationFeature[]
  plans         PlanFeature[]

  createdAt DateTime @default(now())
}

model Plan {
  id               String       @id @default(cuid())
  key              String       @unique // e.g., "BASIC_MONTHLY"
  name             String
  shortDescription String?      @map("short_description")
  description      Json? // Array of strings (points)
  
  price          Decimal      @default(0.0)
  currency       String       @default("INR")
  billingCycle   BillingCycle @default(MONTHLY) @map("billing_cycle")
  durationDays   Int          @default(30) @map("duration_days")
  priceBreakdown Json?        @map("price_breakdown") // Base, Tax, etc.

  // Limits
  maxStaff    Int @default(1) @map("max_staff")
  maxBranches Int @default(1) @map("max_branches")
  storageLimit Int @default(1024) @map("storage_limit") // In MB

  // Feature Toggles (JSON for flexible advanced features)
  // e.g., { "apiAccess": true, "whiteLabeling": false, "prioritySupport": true }
  advancedFeatures Json? @map("advanced_features")

  // UI/Landing Page Helpers
  isPopular Boolean @default(false) @map("is_popular")
  badgeText String? @map("badge_text") // e.g., "Best Value"
  status    Int     @default(1) // 1=Active, 0=Inactive

  // Relations
  features      PlanFeature[]
  organizations Organization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model PlanFeature {
  id        String @id @default(cuid())
  planId    String
  featureId String
  config    Json? // Default config for this feature in this plan

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model OrganizationFeature {
  id             String  @id @default(cuid())
  organizationId String
  featureId      String
  enabled        Boolean @default(true)
  config         Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureId])
}

//////////////////////////////////////////////////////
// 2. MULTI-TENANCY ROOT (ORGANIZATIONS & BRANCHES)
//////////////////////////////////////////////////////

model Organization {
  id     String           @id @default(cuid())
  name   String
  status Int              @default(1) // 1=Active, 0=Inactive
  type   OrganizationType @default(PHARMACY)

  branches Branch[]
  features OrganizationFeature[]

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganizationType {
  PHARMACY
  WHOLESALE
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  address String?
  status  Int     @default(1)

  // Assignments scoped to this branch
  userRoles       UserRole[]
  userWorkflows   UserWorkflow[]
  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

//////////////////////////////////////////////////////
// 3. IDENTITY & RBAC SYSTEM (GLOBAL/CROSS-TENANT)
//////////////////////////////////////////////////////

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String // Hashed password
  mobile   String?
  regNo    String? @unique @map("reg_no")
  status   Int     @default(1) // 1=Active, 0=Inactive

  // 2FA (Fortify-style)
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorConfirmedAt DateTime? @map("two_factor_confirmed_at")

  lastLogin DateTime? @map("last_login")

  // RBAC & Workflow Assignments
  roles       UserRole[]
  workflows   UserWorkflow[]
  permissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Role {
  id    String  @id @default(cuid())
  key   String  @unique // e.g., 'super_admin', 'pharmacy_admin'
  name  String? // Human readable name
  level Int     @default(0) // Hierarchy level (higher = more power)

  scopeType String  @default("global") @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id") // Optional specific scope

  permissions RolePermission[]
  workflows   RoleWorkflow[]
  userRoles   UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g., 'users.create'
  module String // Grouping (e.g., 'Admissions', 'Inventory')

  workflowPermissions WorkflowPermission[]
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  permissions   WorkflowPermission[]
  roles         RoleWorkflow[]
  userWorkflows UserWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relation Tables for RBAC
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RoleWorkflow {
  id         String @id @default(cuid())
  roleId     String
  workflowId String

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([roleId, workflowId])
}

model WorkflowPermission {
  id           String @id @default(cuid())
  workflowId   String
  permissionId String

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workflowId, permissionId])
}

//////////////////////////////////////////////////////
// 4. TENANT ASSIGNMENTS (SCOPING USERS TO BRANCHES)
//////////////////////////////////////////////////////

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  @@unique([userId, roleId, scopeId])
}

model UserWorkflow {
  id         String @id @default(cuid())
  userId     String
  workflowId String

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id])
  branchId String?

  @@unique([userId, workflowId, scopeId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true) // true = grant, false = revoke override

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id])
  branchId   String?

  @@unique([userId, permissionId, scopeId])
}
