generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

enum HsnType {
  GOODS
  SERVICE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CREDIT
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
  RETURNED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

//////////////////////////////////////////////////////
// TENANT + RBAC (MULTI-TENANT ISOLATION CORE)
//////////////////////////////////////////////////////

model Tenant {
  id     String       @id @default(cuid())
  name   String
  status TenantStatus @default(ACTIVE)

  users User[]
  roles Role[]

  branches       Branch[]
  products       TenantProduct[]
  suppliers      Supplier[]
  customers      Customer[]
  doctors        Doctor[]
  stockTransfers StockTransfer[]

  subscriptions TenantSubscription[]
  features      TenantFeature[]
  setting       TenantSetting?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hsnCodes     HsnCode[]
  companies    Company[]
  productTypes ProductType[]
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name         String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  // Granular Role Access
  userRoles      UserRole[]
  stockTransfers StockTransfer[] // Track who did a transfer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  permissions RolePermission[]
  userRoles   UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model UserRole {
  id       String  @id @default(cuid())
  userId   String
  roleId   String
  branchId String? // If null, user is Tenant Admin. If Branch ID present, user has role in that branch.

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId, branchId])
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
}

//////////////////////////////////////////////////////
// GLOBAL MASTER DATA (SHARED ACROSS TENANTS)
//////////////////////////////////////////////////////

model HsnCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  description String?
  type        HsnType
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  products       MasterProduct[]
  tenantProducts TenantProduct[]
  taxes          HsnTaxMapping[]
}

model TaxRule {
  id        Int      @id @default(autoincrement())
  name      String?
  rate      Decimal  @db.Decimal(5, 2)
  type      TaxType
  country   String   @default("India")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  hsnMappings HsnTaxMapping[]
}

model HsnTaxMapping {
  id            Int       @id @default(autoincrement())
  hsnCodeId     Int
  taxRuleId     Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  hsnCode HsnCode @relation(fields: [hsnCodeId], references: [id])
  taxRule TaxRule @relation(fields: [taxRuleId], references: [id])

  @@index([hsnCodeId])
  @@index([taxRuleId])
}

model Feature {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?
  module      String?
  isActive    Boolean @default(true)

  plans   PlanFeature[]
  tenants TenantFeature[]
}

model Plan {
  id           Int          @id @default(autoincrement())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle
  maxUsers     Int?
  maxInvoices  Int?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  features      PlanFeature[]
  subscriptions TenantSubscription[]
}

model PlanFeature {
  id        Int @id @default(autoincrement())
  planId    Int
  featureId Int

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
}

model TenantSubscription {
  id            Int       @id @default(autoincrement())
  tenantId      String
  planId        Int
  startDate     DateTime
  endDate       DateTime?
  status        String
  paymentStatus String
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
}

model TenantFeature {
  id        Int     @id @default(autoincrement())
  tenantId  String
  featureId Int
  enabled   Boolean @default(true)
  config    Json?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([tenantId, featureId])
}

model TenantSetting {
  tenantId String @id

  inventoryEnabled Boolean @default(true)
  rackEnabled      Boolean @default(false)
  batchEnabled     Boolean @default(false)
  expiryEnabled    Boolean @default(false)
  gstEnabled       Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Salt {
  id   Int    @id @default(autoincrement())
  name String @unique

  compositions MedicineComposition[]
}

model Company {
  id       Int           @id @default(autoincrement())
  name     String
  gstin    String?       @unique
  status   CompanyStatus @default(ACTIVE)
  tenantId String?
  tenant   Tenant?       @relation(fields: [tenantId], references: [id])

  products       MasterProduct[]
  tenantProducts TenantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductType {
  id        Int     @id @default(autoincrement())
  name      String
  unit_type String
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])

  products       MasterProduct[]
  tenantProducts TenantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterProduct {
  id           Int     @id @default(autoincrement())
  name         String
  generic_name String?
  brand_name   String?
  strength     String?
  pack_size    Int?
  unit         String?

  isPrescriptionRequired Boolean @default(false)
  scheduleType           String?

  hsnCodeId Int
  hsnCode   HsnCode @relation(fields: [hsnCodeId], references: [id])

  company_id Int
  company    Company @relation(fields: [company_id], references: [id])

  product_type_id Int
  product_type    ProductType @relation(fields: [product_type_id], references: [id])

  compositions   MedicineComposition[]
  tenantProducts TenantProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, strength, company_id])
}

model MedicineComposition {
  id Int @id @default(autoincrement())

  productId Int
  saltId    Int

  strength String

  product MasterProduct @relation(fields: [productId], references: [id])
  salt    Salt          @relation(fields: [saltId], references: [id])

  @@unique([productId, saltId])
}

//////////////////////////////////////////////////////
// TENANT DATA (STRICTLY ISOLATED)
//////////////////////////////////////////////////////

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  phone   String?
  email   String?
  address String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Doctor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name               String
  registrationNumber String?
  phone              String?
  specialization     String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Branch {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  address String?

  racks       Rack[]
  batches     Batch[]
  sales       Sale[]
  purchases   Purchase[]
  inventories Inventory[]
  userRoles   UserRole[]

  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Rack {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  name String

  batches Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantProduct {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  masterProductId Int?
  masterProduct   MasterProduct? @relation(fields: [masterProductId], references: [id])

  // Custom Fallback Fields (used if masterProductId is null or for local overrides)
  name                   String
  displayName            String?
  packSize               Int?
  strength               String?
  unit                   String?
  isPrescriptionRequired Boolean @default(false)

  productTypeId Int?
  productType   ProductType? @relation(fields: [productTypeId], references: [id])

  hsnCodeId Int?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  barcode  String?
  isActive Boolean @default(true)

  batches       Batch[]
  inventories   Inventory[]
  purchaseItems PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([masterProductId])
}

// CQRS Materialized View for Inventory (fast reads instead of summing all batches)
model Inventory {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  tenantProductId String
  tenantProduct   TenantProduct @relation(fields: [tenantProductId], references: [id])

  totalQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, tenantProductId])
}

model Batch {
  id String @id @default(cuid())

  tenantProductId String
  tenantProduct   TenantProduct @relation(fields: [tenantProductId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  rackId String?
  rack   Rack?   @relation(fields: [rackId], references: [id])

  batchNumber String
  expiryDate  DateTime

  mrp            Decimal   @db.Decimal(10, 2)
  purchasePrice  Decimal   @db.Decimal(10, 2)
  sellingPrice   Decimal   @db.Decimal(10, 2)
  manufacturedAt DateTime?
  isExpired      Boolean   @default(false)

  quantity     Int
  freeQuantity Int @default(0)

  version Int @default(0) // Optimistic concurrency lock

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  stockLedgers  StockLedger[]
  transferItems StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchNumber, tenantProductId, branchId])
}

model Supplier {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  phone   String?
  email   String?
  gstin   String?
  address String?

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

//////////////////////////////////////////////////////
// TRANSACTIONS
//////////////////////////////////////////////////////

model StockTransfer {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fromBranchId String
  fromBranch   Branch @relation("TransferFrom", fields: [fromBranchId], references: [id])

  toBranchId String
  toBranch   Branch @relation("TransferTo", fields: [toBranchId], references: [id])

  status      TransferStatus @default(PENDING)
  totalAmount Decimal?       @db.Decimal(12, 2)

  items StockTransferItem[]

  createdByUserId String
  user            User   @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockTransferItem {
  id String @id @default(cuid())

  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id String @id @default(cuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  invoiceNumber String?
  invoiceDate   DateTime?

  totalAmount    Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  netAmount      Decimal @db.Decimal(12, 2)

  status        PurchaseStatus @default(RECEIVED)
  paymentStatus PaymentStatus  @default(PENDING)

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id String @id @default(cuid())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  tenantProductId String
  tenantProduct   TenantProduct @relation(fields: [tenantProductId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  quantity     Int
  freeQuantity Int @default(0)

  purchasePrice  Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  netAmount      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  doctorId String?
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  totalAmount    Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  netAmount      Decimal @db.Decimal(12, 2)

  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PAID)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  quantity Int

  // Historical lock-in fields
  price          Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// STOCK LEDGER (AUDIT TRAIL)
//////////////////////////////////////////////////////

model StockLedger {
  id String @id @default(cuid())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  type      StockMovementType
  direction String // IN / OUT
  unitCost  Decimal?          @db.Decimal(10, 2)

  quantity      Int
  referenceId   String?
  referenceType String? // SALE / PURCHASE / TRANSFER

  createdAt DateTime @default(now())

  @@index([batchId])
}
