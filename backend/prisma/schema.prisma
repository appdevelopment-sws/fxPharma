generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  status              TenantStatus         @default(ACTIVE)
  users               User[]
  roles               Role[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  tenantSubscriptions TenantSubscription[]
  tenantFeatures      TenantFeature[]
  tenantSettings      TenantSetting[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, roleId])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  isDefault   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

//////////////////////////////////////////////////////
// NEW ENUMS
//////////////////////////////////////////////////////

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

enum HsnType {
  GOODS
  SERVICE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

//////////////////////////////////////////////////////
// REPLACE HSN TABLE
//////////////////////////////////////////////////////

model HsnCode {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(10)
  description String?
  type        HsnType
  isActive    Boolean @default(true)

  taxMappings HsnTaxMapping[]
  products    MasterProduct[]

  createdAt DateTime @default(now())
}

model TaxRule {
  id       Int     @id @default(autoincrement())
  name     String? @db.VarChar(50)
  rate     Decimal @db.Decimal(5, 2)
  type     TaxType
  country  String  @default("India")
  isActive Boolean @default(true)

  mappings HsnTaxMapping[]

  createdAt DateTime @default(now())
}

model HsnTaxMapping {
  id Int @id @default(autoincrement())

  hsnCodeId Int
  taxRuleId Int

  hsnCode HsnCode @relation(fields: [hsnCodeId], references: [id])
  taxRule TaxRule @relation(fields: [taxRuleId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([hsnCodeId])
  @@index([taxRuleId])
}

//////////////////////////////////////////////////////
// SaaS FEATURES SYSTEM
//////////////////////////////////////////////////////

model Feature {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  description String?
  module      String?
  isActive    Boolean @default(true)

  planFeatures   PlanFeature[]
  tenantFeatures TenantFeature[]
}

model Plan {
  id           Int          @id @default(autoincrement())
  name         String
  price        Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle

  maxUsers    Int?
  maxInvoices Int?

  isActive Boolean @default(true)

  features      PlanFeature[]
  subscriptions TenantSubscription[]

  createdAt DateTime @default(now())
}

model PlanFeature {
  id Int @id @default(autoincrement())

  planId    Int
  featureId Int

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
}

//////////////////////////////////////////////////////
// TENANT EXTENSIONS (NO BREAKING CHANGE)
//////////////////////////////////////////////////////

model TenantSubscription {
  id Int @id @default(autoincrement())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  planId Int
  plan   Plan @relation(fields: [planId], references: [id])

  startDate DateTime
  endDate   DateTime?

  status        String
  paymentStatus String

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model TenantFeature {
  id Int @id @default(autoincrement())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  featureId Int
  feature   Feature @relation(fields: [featureId], references: [id])

  enabled Boolean @default(true)
  config  Json?

  @@unique([tenantId, featureId])
}

model TenantSetting {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inventoryEnabled Boolean @default(true)
  rackEnabled      Boolean @default(false)
  batchEnabled     Boolean @default(false)
  expiryEnabled    Boolean @default(false)
  gstEnabled       Boolean @default(true)
}

//////////////////////////////////////////////////////
// UPDATE EXISTING PRODUCT MODELS
//////////////////////////////////////////////////////

model ProductType {
  id          Int     @id @default(autoincrement())
  name        String
  unit_type   String
  description String?

  products MasterProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id     Int           @id @default(autoincrement())
  gstin  String?       @unique
  name   String
  status CompanyStatus @default(ACTIVE)

  products MasterProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterProduct {
  id         Int     @id @default(autoincrement())
  name       String
  salt       String
  barcode    String? @unique
  brand_name String?
  pack_size  String?
  strength   String?

  hsnCodeId Int
  hsnCode   HsnCode @relation(fields: [hsnCodeId], references: [id])

  company_id Int
  company    Company @relation(fields: [company_id], references: [id])

  product_type_id Int
  product_type    ProductType @relation(fields: [product_type_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, strength, company_id])
  @@index([company_id])
  @@index([product_type_id])
  @@index([hsnCodeId])
}
