generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  users     User[]
  roles     Role[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, roleId])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  description String?
  isDefault   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model HsnTable {
  id              Int       @id @default(autoincrement())
  hsn_code        String    @unique
  item_type       String
  hsn_description String?
  gst_rate        Decimal
  last_changed    DateTime?
  last_gst_rate   Decimal?

  medicines MasterMedicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductType {
  id          Int     @id @default(autoincrement())
  name        String
  unit_type   String
  description String?

  medicines MasterMedicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Company {
  id     Int           @id @default(autoincrement())
  gstin  String?       @unique
  name   String
  status CompanyStatus @default(ACTIVE)

  medicines MasterMedicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterMedicine {
  id            Int     @id @default(autoincrement())
  medicine_name String
  salt          String
  barcode       String? @unique
  brand_name    String?
  pack_size     String?
  strength      String?

  hsn_id Int
  hsn    HsnTable @relation(fields: [hsn_id], references: [id])

  company_id Int
  company    Company @relation(fields: [company_id], references: [id])

  product_type_id Int
  product_type    ProductType @relation(fields: [product_type_id], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicine_name, strength, company_id])
  @@index([company_id])
  @@index([product_type_id])
  @@index([hsn_id])
}
