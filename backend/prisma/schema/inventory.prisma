
model Inventory {
  id              String  @id @default(cuid())
  organizationId  String  @map("organization_id")
  branchId        String? @map("branch_id")
  
  // 01 Product Identification
  name            String
  status          InventoryStatus @default(CONTINUE)
  imageUrl        String?  @map("image_url")
  manufacturerId  String @map("manufacturer_id")
  saltComposition String?  @map("salt_composition")
  categoryId       String?  @default("TAB")
  brandId          String?  @map("brand_id")
  unitId           String?  @map("unit_id")
  // 02 Classification & Units
  packing         String?
  unit1st         String?  @map("unit_1st")
  unit2nd         String?  @map("unit_2nd")
  packQty1        Int?     @default(0) @map("pack_qty_1")
  packQty2        Int?     @default(0) @map("pack_qty_2")
  packQty3        Int?     @default(0) @map("pack_qty_3")
  hsnCode         String?  @map("hsn_code")
  itemType        String?  @default("NORMAL") @map("item_type")
  colorType       String?  @default("NORMAL") @map("color_type")
  decimal         String?  @default("No")
  type            String?  @default("NORMAL")

  // 03 Pricing & Taxation
  localTax        String?  @default("Taxable") @map("local_tax")
  centralTax      String?  @default("Taxable") @map("central_tax")
  sgst            Decimal? @default(0.0)
  cgst            Decimal? @default(0.0)
  igst            Decimal? @default(0.0)
  mrp             Decimal? @default(0.0)
  purchaseRate    Decimal? @default(0.0) @map("purchase_rate")
  costPerUnit     Decimal? @default(0.0) @map("cost_per_unit")
  rateA           Decimal? @default(0.0) @map("rate_a")
  rateB           Decimal? @default(0.0) @map("rate_b")
  rateC           Decimal? @default(0.0) @map("rate_c")
  cer             Decimal? @default(0.0)

  // 04 Inventory Thresholds
  minQty          Int?     @default(0) @map("min_qty")
  maxQty          Int?     @default(0) @map("max_qty")
  reorderQty      Int?     @default(0) @map("reorder_qty")
  daysLimit       String?     @map("days_limit")
  temperatureLimit Decimal? @default(0.0) @map("temperature_limit")
  convStri        Decimal? @default(0.0) @map("conv_stri")
  convCas         Decimal? @default(0.0) @map("conv_cas")

  // 05 Discounts & Margins
  volumeDiscount  Decimal? @default(0.0) @map("volume_discount")
  itemDiscount    Decimal? @default(0.0) @map("item_discount")
  maxDiscount     Decimal? @default(0.0) @map("max_discount")
  minMargin       Decimal? @default(0.0) @map("min_margin")
  specialDiscount Decimal? @default(0.0) @map("special_discount")
  purchaseDiscount Decimal? @default(0.0) @map("purchase_discount")

  // 06 Regulatory & Product Flags
  isNarcotic      Boolean  @default(false) @map("is_narcotic")
  isScheduleH     Boolean  @default(false) @map("is_schedule_h")
  isScheduleH1    Boolean  @default(false) @map("is_schedule_h1")
  hideProduct     Boolean  @default(false) @map("hide_product")
  negativeStock   Boolean  @default(false) @map("negative_stock")
  editRates       Boolean  @default(true)  @map("edit_rates")
  availableStock   Int?     @default(0) @map("available_stock")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orderItems OrderItem[]
  batches InventoryBatch[]
  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  @@index([organizationId])
  @@index([branchId])
  @@index([name])
}

model InventoryBatch {
  id            String   @id @default(cuid())
  organizationId String  @map("organization_id")
  branchId      String?  @map("branch_id")
  inventoryId   String   @map("inventory_id")
  orderId       String?  @map("order_id")
  orderItemId   String?  @map("order_item_id")

  batchNo       String   @map("batch_no")
  expiry        String?  @map("expiry")
  expiryDate    String? @map("expiry_date")

  unit          String?
  receivedQty   Int      @default(0) @map("received_qty")
  availableQty  Int      @default(0) @map("available_qty")
  purchaseRate  Decimal? @default(0.0) @map("purchase_rate")
  mrp           Decimal? @default(0.0)
  rateA         Decimal? @default(0.0) @map("rate_a")
  rateB         Decimal? @default(0.0) @map("rate_b")
  rateC         Decimal? @default(0.0) @map("rate_c")
  cgst          Decimal? @default(0.0)
  sgst          Decimal? @default(0.0)

  receivedAt    DateTime @default(now()) @map("received_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([organizationId])
  @@index([branchId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([batchNo])
  @@index([expiryDate])
}

enum InventoryStatus {
  CONTINUE
  DISCONTINUE
}


// packing = selected outer type
// unit1st = selected middle type
// unit2nd = selected inner type
// packQty1 = quantity for packing
// packQty2 = quantity for unit1st
// packQty3 = quantity for unit2nd
