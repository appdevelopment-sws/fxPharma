
//////////////////////////////////////////////////////
// ORGANIZATION MEMBER
//////////////////////////////////////////////////////

model OrganizationMember {
  id              String    @id @default(cuid())

  //////////////////////////////////////////////////////
  // USER
  //////////////////////////////////////////////////////

  userId          String
  user            User @relation("UserOrganizations", fields: [userId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // ORGANIZATION
  //////////////////////////////////////////////////////

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////////
  // ROLE
  //////////////////////////////////////////////////////

  roleId          String
  role            Role @relation(fields: [roleId], references: [id])

  //////////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////////

  status          MembershipStatus @default(ACTIVE)

  //////////////////////////////////////////////////////
  // INVITATION
  //////////////////////////////////////////////////////

  invitedById     String?
  invitedBy       User? @relation("MemberInvitedBy", fields: [invitedById], references: [id])

  joinedAt        DateTime @default(now())

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  branches        MemberBranch[]

  permissions     MemberPermission[]

  //////////////////////////////////////////////////////
  // ONE USER = ONE ENTRY PER ORGANIZATION
  //////////////////////////////////////////////////////

  @@unique([userId, organizationId])

  @@index([organizationId])

  @@index([roleId])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}