model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Float
  taxType   TaxType  @default(Exclusive) @map("tax_type")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hsnMappings HsnMapping[]
}

enum TaxType {
  Exclusive
  Inclusive
}

model Hsn {
  id          String   @id @default(cuid())
  hsncode     String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hsnMappings HsnMapping[]
  masterProducts MasterProduct[]
}

model HsnMapping {
  id        String   @id @default(cuid())
  hsnid     String
  taxid     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hsn Hsn @relation(fields: [hsnid], references: [id], onDelete: Cascade)
  tax Tax @relation(fields: [taxid], references: [id], onDelete: Cascade)

  @@unique([hsnid, taxid])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  masterProducts MasterProduct[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      CategoryStatus @default(ACTIVE)

  // Self-relation for hierarchy
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  masterProducts MasterProduct[]
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  status    ManufacturerStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterProducts MasterProduct[]
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  status    UnitStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ManufacturerStatus {
  ACTIVE
  INACTIVE
}

model Salt {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MasterProduct {
  id              String  @id @default(cuid())
  name            String
  industrySegment String? @default("1") @map("industry_segment")
  imageUrl        String? @map("image_url")

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  brandId String? @map("brand_id")
  brand   Brand?  @relation(fields: [brandId], references: [id])

  manufacturerId String?       @map("manufacturer_id")
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])

  salt String?

  hsnId String? @map("hsn_id")
  hsn   Hsn?    @relation(fields: [hsnId], references: [id])

  categoryType String? @default("TAB") @map("category_type")
  status       String? @default("CONTINUE")
  colorType    String? @default("NORMAL") @map("color_type")

  isNarcotic   Boolean @default(false) @map("is_narcotic")
  isScheduleH  Boolean @default(false) @map("is_schedule_h")
  isScheduleH1 Boolean @default(false) @map("is_schedule_h1")

  barcodes MasterProductBarcode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  @@index([name])
}

model MasterProductBarcode {
  id              String        @id @default(cuid())
  value           String        @unique
  masterProductId String        @map("master_product_id")
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([value])
}
