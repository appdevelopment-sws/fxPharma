model User {
  id        String  @id @default(cuid())
  firstName String? @map("first_name")
  lastName  String? @map("last_name")
  name      String?
  email     String  @unique
  password  String // Hashed password
  mobile    String? @unique
  regNo     String? @unique @map("reg_no")
  status    Int     @default(1) // 1=Active, 0=Inactive

  // 2FA (Fortify-style)
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorConfirmedAt DateTime? @map("two_factor_confirmed_at")

  lastLogin DateTime? @map("last_login")

  // RBAC & Workflow Assignments
  roles       UserRole[]
  workflows   UserWorkflow[]
  permissions UserPermission[]

  // Organizations owned by this user
  ownedOrganizations Organization[] @relation("OrganizationOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Role {
  id    String  @id @default(cuid())
  key   String  @unique // e.g., 'super_admin', 'pharmacy_admin'
  name  String? // Human readable name
  level Int     @default(0) // Hierarchy level (higher = more power)

  scopeType String  @default("global") @map("scope_type") // 'global' or 'branch'
  scopeId   String? @map("scope_id") // Optional specific scope

  permissions RolePermission[]
  workflows   RoleWorkflow[]
  userRoles   UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g., 'users.create'
  module String // Grouping (e.g., 'Admissions', 'Inventory')

  workflowPermissions WorkflowPermission[]
  rolePermissions     RolePermission[]
  userPermissions     UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  permissions   WorkflowPermission[]
  roles         RoleWorkflow[]
  userWorkflows UserWorkflow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relation Tables for RBAC
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RoleWorkflow {
  id         String @id @default(cuid())
  roleId     String
  workflowId String

  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([roleId, workflowId])
}

model WorkflowPermission {
  id           String @id @default(cuid())
  workflowId   String
  permissionId String

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([workflowId, permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id])
  branchId String?

  @@unique([userId, roleId, scopeId])
}

model UserWorkflow {
  id         String @id @default(cuid())
  userId     String
  workflowId String

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id])
  branchId String?

  @@unique([userId, workflowId, scopeId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true) // true = grant, false = revoke override

  scopeType String  @map("scope_type") // 'global', 'organization' or 'branch'
  scopeId   String? @map("scope_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id])
  branchId   String?

  @@unique([userId, permissionId, scopeId])
}
