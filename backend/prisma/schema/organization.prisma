model Organization {
  id          String    @id @default(cuid())

  name        String
  slug        String    @unique

  description String?
  category    String?
  logo        String?
  gstNo       String?
  licenseNo   String?
  timezone    String?
  currency    String?
  ownerEmail  String?


  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  branches    Branch[]

  members     OrganizationMember[]
  features  OrganizationFeature[]

  roles       Role[]
  orders       Order[]

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])
  suppliers   Supplier[]
  auditLogs   AuditLog[]
  inventory Inventory[]
  newCompounds NewCompound[]
  brands Brand[]
  units Unit[]
  categories Category[]
  manufacturers Manufacturer[]
  settings Setting[]
  @@index([slug])
}

