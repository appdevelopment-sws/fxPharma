model Organization {
  id          String    @id @default(cuid())

  name        String
  slug        String    @unique

  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  branches    Branch[]

  members     OrganizationMember[]

  roles       Role[]

  auditLogs   AuditLog[]

  @@index([slug])
}

