
//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id            String    @id @default(cuid())

  //////////////////////////////////////////////////////
  // Examples:
  // user.create
  // user.update
  // branch.create
  // inventory.view
  // medicine.create
  //////////////////////////////////////////////////////

  key           String    @unique

  name          String

  description   String?

  createdAt     DateTime  @default(now())

  //////////////////////////////////////////////////////
  // RELATIONS
  //////////////////////////////////////////////////////

  roles         RolePermission[]

  users         MemberPermission[]
}

