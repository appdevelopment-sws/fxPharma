<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{invoiceId}} - {{brandName}}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #111827;
        --muted: #6b7280;
        --line: #d1d5db;
        --soft: #f3f4f6;
        --accent: #0f766e;
        --accent-soft: #ecfeff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: linear-gradient(135deg, #f9fafb 0%, #eff6ff 100%);
        color: var(--ink);
        font-family: Arial, Helvetica, sans-serif;
      }

      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 18mm;
        background: #ffffff;
      }

      .header {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 2px solid var(--line);
        padding-bottom: 18px;
        margin-bottom: 18px;
      }

      .brand {
        max-width: 65%;
      }

      .brand h1 {
        margin: 0 0 6px;
        font-size: 28px;
        line-height: 1.1;
        color: var(--accent);
      }

      .brand p {
        margin: 4px 0;
        color: var(--muted);
        font-size: 12px;
      }

      .meta {
        min-width: 230px;
        background: var(--soft);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 14px;
      }

      .meta-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 12px;
        padding: 4px 0;
      }

      .meta-row strong {
        font-weight: 700;
      }

      .section-title {
        margin: 0 0 10px;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .details {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 16px;
        margin-bottom: 18px;
      }

      .card {
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 14px;
        background: #ffffff;
      }

      .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 5px 0;
        font-size: 12px;
        border-bottom: 1px dashed #e5e7eb;
      }

      .detail-row:last-child {
        border-bottom: 0;
      }

      .detail-label {
        color: var(--muted);
      }

      .detail-value {
        font-weight: 600;
        text-align: right;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
      }

      thead th {
        text-align: left;
        background: var(--accent-soft);
        color: var(--accent);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 10px 8px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      tbody td {
        border-bottom: 1px solid #e5e7eb;
        padding: 10px 8px;
        vertical-align: top;
      }

      .cell-center {
        text-align: center;
      }

      .cell-right {
        text-align: right;
        white-space: nowrap;
      }

      .item-title {
        font-weight: 700;
      }

      .item-meta {
        margin-top: 4px;
        color: var(--muted);
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 11px;
      }

      .summary {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 1fr 290px;
        gap: 16px;
        align-items: start;
      }

      .summary-table td {
        padding: 8px 10px;
        border-bottom: 1px solid #e5e7eb;
      }

      .summary-table tr:last-child td {
        border-bottom: 0;
        font-weight: 800;
        font-size: 13px;
        background: var(--soft);
      }

      .notes {
        border-left: 4px solid var(--accent);
        background: #f8fafc;
        padding: 14px;
        border-radius: 12px;
        color: var(--ink);
        font-size: 12px;
      }

      .notes-label {
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 6px;
      }

      .footer {
        margin-top: 20px;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: var(--muted);
        font-size: 11px;
      }

      @page {
        size: A4;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="header">
        <div class="brand">
          <h1>{{brandName}}</h1>
          <p>{{brandTagline}}</p>
          <p>{{brandAddress}}</p>
          <p>{{companyContactBlock}}</p>
          <p>GSTIN: {{brandGstin}}</p>
        </div>
        <aside class="meta">
          <div class="meta-row"><strong>Invoice</strong><span>{{invoiceId}}</span></div>
          <div class="meta-row"><strong>Date</strong><span>{{createdAt}}</span></div>
          <div class="meta-row"><strong>Status</strong><span>{{invoiceStatus}}</span></div>
          <div class="meta-row"><strong>Payment</strong><span>{{paymentMode}}</span></div>
          <div class="meta-row"><strong>Items</strong><span>{{itemCount}}</span></div>
        </aside>
      </section>

      <section class="details">
        <div class="card">
          <h2 class="section-title">Customer</h2>
          <div class="detail-row">
            <span class="detail-label">Name</span>
            <span class="detail-value">{{customerName}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Phone</span>
            <span class="detail-value">{{customerPhone}}</span>
          </div>
        </div>

        <div class="card">
          <h2 class="section-title">Totals</h2>
          <div class="detail-row">
            <span class="detail-label">Gross</span>
            <span class="detail-value">{{grossAmount}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Discount</span>
            <span class="detail-value">{{discountAmount}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Tax</span>
            <span class="detail-value">{{taxAmount}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Total</span>
            <span class="detail-value">{{totalAmount}}</span>
          </div>
        </div>
      </section>

      <section class="card">
        <h2 class="section-title">Items</h2>
        <table>
          <thead>
            <tr>
              <th style="width: 44px;">#</th>
              <th>Item</th>
              <th style="width: 72px;" class="cell-center">Qty</th>
              <th style="width: 105px;" class="cell-right">Rate</th>
              <th style="width: 105px;" class="cell-right">Discount</th>
              <th style="width: 120px;" class="cell-right">Amount</th>
            </tr>
          </thead>
          <tbody>
            {{{itemsRows}}}
          </tbody>
        </table>
      </section>

      <section class="summary">
        <div>
          {{{notesBlock}}}
        </div>
        <div class="card">
          <h2 class="section-title">Summary</h2>
          <table class="summary-table">
            <tbody>
              {{{summaryRows}}}
            </tbody>
          </table>
        </div>
      </section>

      <footer class="footer">
        <span>Generated for {{brandName}}</span>
        <span>Template: {{safeTemplateName}}</span>
      </footer>
    </main>
  </body>
</html>
