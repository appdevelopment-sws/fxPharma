<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bill - {{invoiceId}}</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        background: #f1f5f9;
        color: #222;
        line-height: 1.3;
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        background: #ffffff;
        padding: 12mm;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .bill-container {
        position: relative;
        background: #fff;
        overflow: hidden;
      }
      .section-title {
        font-size: 14px;
        font-weight: bold;
        margin-top: 15px;
        margin-bottom: 5px;
        color: #333;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .info-table,
      .charges-table,
      .account-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 10px;
      }
      .info-table td,
      .account-table td {
        padding: 4px 6px;
        vertical-align: top;
      }
      .charges-table th,
      .charges-table td,
      .account-table th,
      .account-table td {
        border: 1px solid #ccc;
        padding: 6px;
        color: black;
        vertical-align: top;
      }
      .charges-table th {
        background: #f8f8f8;
        text-align: left;
      }
      .charges-table td {
        text-align: right;
      }
      .charges-table td.description,
      .charges-table th.description {
        text-align: left;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: normal;
      }
      .charges-table td.amount {
        white-space: nowrap;
      }
      
      .table-container {
        border: 1px solid #ccc;
        margin-bottom: 10px;
        height: 480px;
        display: flex;
        background-color: #ffffff;
      }
      
      .charges-table-fixed {
        width: 100%;
        border-collapse: collapse;
        height: 100%;
      }
      
      .charges-table-fixed th,
      .charges-table-fixed td {
        border: 1px solid #ccc;
        padding: 6px;
        color: black;
        vertical-align: top;
      }
      
      .charges-table-fixed th {
        background-color: #0d47a1;
        color: #ffffff;
        text-align: left;
        font-size: 12px;
        font-weight: bold;
      }
      
      .charges-table-fixed td {
        text-align: right;
        font-size: 11.5px;
      }
      
      .charges-table-fixed td.cell-center,
      .charges-table-fixed th.cell-center {
        text-align: center;
      }
      
      .charges-table-fixed td.cell-right,
      .charges-table-fixed th.cell-right {
        text-align: right;
      }
      
      .charges-table-fixed tr.spacer-row {
        height: 100%;
      }
      
      .charges-table-fixed tr.spacer-row td {
        border-top: none;
        border-bottom: none;
        padding: 0;
      }

      .item-title {
        font-weight: bold;
        text-align: left;
      }
      
      .item-meta {
        font-size: 10px;
        color: #555;
        display: flex;
        gap: 8px;
        margin-top: 3px;
      }

      .summary-table {
        width: 100%;
        border-collapse: collapse;
      }
      
      .summary-table td {
        padding: 4px 6px;
        font-size: 11.5px;
        color: black;
        border: none !important;
        text-align: left;
      }
      
      .summary-table td.cell-right {
        text-align: right;
        font-weight: bold;
      }
      
      /* Style Net Amount row (5th child: Total Amount) */
      .summary-table tr:nth-child(5) td {
        border-top: 1px solid #ccc !important;
        border-bottom: 1px solid #ccc !important;
        font-weight: bold;
      }
      /* Hide Change row */
      .summary-table tr:nth-child(7) {
        display: none;
      }

      .signature-section {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
        padding-top: 10px;
        font-size: 11px;
      }
      .footer {
        text-align: center;
        padding: 10px;
        border-top: 1px solid #0d47a1;
        margin-top: 20px;
        font-size: 11px;
      }
      
      @page {
        size: A4;
        margin: 0;
      }

      @media print {
        body {
          background: none !important;
          color: #000000 !important;
        }
        .page {
          box-shadow: none !important;
          padding: 8mm !important;
          width: 100% !important;
          min-height: 0 !important;
        }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <div class="bill-container">
        <!-- Header -->
        <table width="100%" style="border-bottom: 2px solid #0d47a1; margin-bottom: 20px; padding-bottom: 15px;">
          <tr>
            <td style="text-align: left; vertical-align: top;">
              <div style="font-size: 18px; font-weight: bold; color: #0d47a1; margin-bottom: 5px;">
                {{brandName}}
              </div>
              <div style="font-size: 12px; color: #555; line-height: 1.4;">
                {{brandTagline}}<br />
                Address: {{brandAddress}}<br />
                Contact: {{companyContactBlock}}<br />
                {{brandLicenseBlock}}
              </div>
            </td>
            <td style="vertical-align: top; text-align: right;">
              <img src="{{brandLogo}}" alt="Logo" style="max-height: 60px; max-width: 220px;" onerror="this.style.display='none'" />
            </td>
          </tr>
        </table>

        <!-- Client Info -->
        <div class="section-title">Bill To</div>
        <table class="info-table">
          <tr>
            <td style="width: 15%;"><strong>Invoice No:</strong></td>
            <td style="width: 35%;">{{invoiceId}}</td>
            <td style="width: 15%;"><strong>Date:</strong></td>
            <td style="width: 35%;">{{createdAt}}</td>
          </tr>
          <tr>
            <td><strong>Client Name:</strong></td>
            <td>{{customerName}}</td>
            <td><strong>Phone:</strong></td>
            <td>{{customerPhone}}</td>
          </tr>
          <tr>
            <td><strong>Payment:</strong></td>
            <td>{{paymentMode}}</td>
            <td><strong>Status:</strong></td>
            <td>{{invoiceStatus}}</td>
          </tr>
          <tr>
            <td><strong>Items:</strong></td>
            <td colspan="3">{{itemCount}}</td>
          </tr>
        </table>

        <!-- Charges Table (Height-fixed container to draw columns all the way down) -->
        <div class="section-title">Charges</div>
        <div class="table-container">
          <table class="charges-table-fixed">
            <colgroup>
              <col style="width: 50px;" />
              <col />
              <col style="width: 65px;" />
              <col style="width: 105px;" />
              <col style="width: 95px;" />
              <col style="width: 115px;" />
            </colgroup>
            <thead>
              <tr>
                <th class="cell-center">Serial No.</th>
                <th>Description</th>
                <th class="cell-center">Qty</th>
                <th class="cell-right">Rate</th>
                <th class="cell-right">Discount</th>
                <th class="cell-right">Amount</th>
              </tr>
            </thead>
            <tbody>
              {{{itemsRows}}}
              <tr class="spacer-row">
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Summary -->
        <table class="charges-table">
          <tr>
            <td style="text-align: left; font-weight: bold; width: 45%; vertical-align: top;">
              {{{notesBlock}}}
            </td>
            <td style="text-align: right; padding: 0; vertical-align: top;">
              <table class="summary-table">
                <tbody>
                  {{{summaryRows}}}
                </tbody>
              </table>
            </td>
          </tr>
        </table>

        <!-- Terms and Footer Message -->
        <div style="margin-top: 15px; border-top: 1px dashed #ccc; padding-top: 10px; font-size: 10px; color: #555;">
          {{{invoiceTermsBlock}}}
          {{{invoiceFooterBlock}}}
        </div>

        <div class="signature-section">
          <div>This is a computer-generated invoice and does not require a signature.</div>
        </div>
      </div>

      <div class="footer">
        <div style="font-weight: bold; color: #0d47a1; margin-bottom: 4px;">
          Contact us: {{companyContactBlock}}
        </div>
        <div>
          Generated for {{brandName}}
        </div>
      </div>
    </main>
  </body>
</html>
