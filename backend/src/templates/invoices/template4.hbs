<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Invoice - {{invoiceId}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@700;800&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --blue:   #1565C0;
      --dark:   #1a1a2e;
      --accent: #0d47a1;
      --light:  #f4f7fb;
      --border: #dde3ed;
      --text:   #2c2c3e;
    }

    body {
      font-family: 'Barlow', sans-serif;
      background: #e8ecf3;
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px;
    }

    .page {
      background: #fff;
      width: 750px;
      box-shadow: 0 8px 40px rgba(0,0,0,.14);
      display: flex;
      flex-direction: column;
    }

    /* ─── HEADER ──────────────────────────────── */
    .header {
      background: linear-gradient(135deg, var(--blue) 60%, #0a3d91 100%);
      padding: 28px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }
    .header::before {
      content: '';
      position: absolute;
      top: -30px; right: -30px;
      width: 130px; height: 130px;
      background: rgba(255,255,255,.08);
      border-radius: 50%;
    }
    .header::after {
      content: '';
      position: absolute;
      bottom: -20px; right: 70px;
      width: 80px; height: 80px;
      background: rgba(255,255,255,.06);
      border-radius: 50%;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 14px;
      z-index: 1;
    }
    .logo-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      width: 48px;
    }
    .logo-box span {
      display: block;
      height: 20px;
      background: #fff;
      border-radius: 3px;
    }
    .logo-box span:nth-child(1) { background: var(--dark); }
    .logo-box span:nth-child(4) { background: rgba(255,255,255,.5); }

    .company-info h1 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 22px;
      font-weight: 800;
      color: #fff;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }
    .company-info p {
      font-size: 11px;
      color: rgba(255,255,255,.75);
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-top: 2px;
    }

    .invoice-badge {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 48px;
      font-weight: 800;
      color: #fff;
      letter-spacing: 4px;
      text-transform: uppercase;
      z-index: 1;
    }

    /* ─── META BAR ───────────────────────────── */
    .meta-bar {
      background: var(--dark);
      display: flex;
      justify-content: space-between;
      padding: 10px 36px;
    }
    .meta-bar span {
      font-size: 13px;
      color: rgba(255,255,255,.85);
      letter-spacing: .5px;
    }
    .meta-bar strong {
      color: #fff;
      font-weight: 700;
    }

    /* ─── BODY ───────────────────────────────── */
    .body {
      padding: 32px 36px 28px;
      flex: 1;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 28px;
      gap: 32px;
    }
    .info-block h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      border-bottom: 2px solid var(--blue);
      padding-bottom: 4px;
      margin-bottom: 8px;
    }
    .info-block p {
      font-size: 13px;
      line-height: 1.7;
      color: var(--text);
    }
    .info-block table { border-collapse: collapse; }
    .info-block table td {
      font-size: 13px;
      padding: 2px 16px 2px 0;
      vertical-align: top;
      color: var(--text);
    }
    .info-block table td:first-child { color: #666; font-weight: 600; }

    /* ─── ITEMS TABLE ────────────────────────── */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .items-table thead tr {
      background: var(--blue);
    }
    .items-table thead th {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 13px;
      font-weight: 700;
      color: #fff;
      text-transform: uppercase;
      letter-spacing: 1px;
      padding: 10px 14px;
      text-align: left;
    }
    .items-table thead th:last-child,
    .items-table thead th:nth-child(4),
    .items-table thead th:nth-child(5),
    .items-table thead th:nth-child(6) { text-align: right; }

    .items-table tbody tr { border-bottom: 1px solid var(--border); }
    .items-table tbody tr:nth-child(even) { background: var(--light); }
    .items-table tbody td {
      font-size: 13px;
      padding: 11px 14px;
      color: var(--text);
    }
    .items-table tbody td:nth-child(3),
    .items-table tbody td:nth-child(4),
    .items-table tbody td:nth-child(5),
    .items-table tbody td:nth-child(6) { text-align: right; }
    .items-table tbody td:nth-child(1) { color: #888; font-weight: 600; }

    /* Service-generated item row styles */
    .items-table .cell { vertical-align: top; }
    .items-table .cell-center { text-align: center; }
    .items-table .cell-right { text-align: right; }
    .items-table .item-title { font-weight: 600; margin-bottom: 2px; }
    .items-table .item-meta { font-size: 11px; color: #777; }
    .items-table .item-meta span { margin-right: 8px; }

    /* ─── BOTTOM ROW ─────────────────────────── */
    .bottom-row {
      display: flex;
      justify-content: space-between;
      gap: 32px;
      margin-top: 8px;
    }

    .payment-block h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      border-bottom: 2px solid var(--blue);
      padding-bottom: 4px;
      margin-bottom: 8px;
    }
    .payment-block table { border-collapse: collapse; }
    .payment-block table td {
      font-size: 13px;
      padding: 3px 20px 3px 0;
      color: var(--text);
    }
    .payment-block table td:first-child { color: #666; font-weight: 600; }

    .totals-table {
      border-collapse: collapse;
      min-width: 250px;
      align-self: flex-start;
    }
    .totals-table td {
      font-size: 13px;
      padding: 8px 16px;
      border: 1px solid var(--border);
    }
    .totals-table td:last-child { text-align: right; font-weight: 600; }
    .totals-table tr:last-child td {
      background: var(--blue);
      color: #fff;
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* ─── TERMS ──────────────────────────────── */
    .terms {
      margin-top: 28px;
      padding-top: 18px;
      border-top: 2px solid var(--border);
    }
    .terms h3 {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .terms p {
      font-size: 12px;
      color: #777;
      line-height: 1.7;
    }

    /* Notes block styles */
    .notes {
      margin-top: 20px;
      padding: 12px 16px;
      background: var(--light);
      border-left: 3px solid var(--blue);
      border-radius: 4px;
    }
    .notes-label {
      font-weight: 700;
      color: var(--blue);
      font-size: 13px;
      margin-bottom: 4px;
    }
    .notes-value {
      font-size: 13px;
      color: var(--text);
      line-height: 1.6;
    }

    /* ─── FOOTER ─────────────────────────────── */
    .footer {
      position: relative;
      height: 90px;
      overflow: hidden;
      margin-top: 18px;
    }
    .footer svg {
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 100%;
    }
    .footer-content {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 36px;
      z-index: 2;
    }
    .footer-content p {
      font-size: 12px;
      color: rgba(255,255,255,.85);
      letter-spacing: .5px;
    }
    .footer-content strong {
      color: #fff;
    }
    .footer-waves path { }
  </style>
</head>
<body>
<div class="page" style="position:relative;">
  {{{watermarkBlock}}}

  <!-- ═══ HEADER ═══ -->
  <div class="header">
    <div class="logo-area">
      <div class="logo-box">
        <span></span><span></span>
        <span></span><span></span>
      </div>
      <div class="company-info">
        <h1>{{brandName}}</h1>
        <p>{{brandTagline}}</p>
      </div>
    </div>
    <div class="invoice-badge">Invoice</div>
  </div>

  <!-- ═══ META BAR ═══ -->
  <div class="meta-bar">
    <span>Invoice No: <strong>{{invoiceId}}</strong></span>
    <span>Date: <strong>{{createdAt}}</strong></span>
  </div>

  <!-- ═══ BODY ═══ -->
  <div class="body">

    <!-- INVOICE TO / ACCOUNT DETAILS -->
    <div class="info-row">
      <div class="info-block">
        <h3>Bill To:</h3>
        <p>
          {{customerName}}<br>
          {{customerPhone}}
        </p>
      </div>
      <div class="info-block">
        <h3>Store Details:</h3>
        <table>
          <tr><td>Address:</td><td>{{brandAddress}}</td></tr>
          <tr><td>Contact:</td><td>{{companyContactBlock}}</td></tr>
        </table>
      </div>
    </div>

    <!-- ITEMS TABLE -->
    <table class="items-table">
      <thead>
        <tr>
          <th>No</th>
          <th>Item Description</th>
          <th>Qty</th>
          <th>Price</th>
          <th>Discount</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {{{itemsRows}}}
      </tbody>
    </table>

    <!-- PAYMENT + TOTALS -->
    <div class="bottom-row">
      <div class="payment-block">
        <h3>Payment Details:</h3>
        <table>
          <tr><td>Payment Mode:</td><td>{{paymentMode}}</td></tr>
          <tr><td>Status:</td><td>{{invoiceStatus}}</td></tr>
        </table>
        {{{paymentQrBlock}}}
      </div>

      <table class="totals-table">
        {{{summaryRows}}}
      </table>
    </div>

    <!-- TERMS -->
    <div class="terms">
      {{{invoiceTermsBlock}}}
      {{{brandLicenseBlock}}}
    </div>

    <!-- NOTES -->
    {{{notesBlock}}}

  </div><!-- /body -->

  <!-- ═══ FOOTER (SVG wave image design) ═══ -->
  <div class="footer">
    <!-- SVG wave footer graphic -->
    <svg viewBox="0 0 750 90" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <!-- Dark background layer -->
      <rect width="750" height="90" fill="#1a1a2e"/>
      <!-- Blue wave top -->
      <path d="M0,55 C120,10 250,80 380,40 C510,0 640,60 750,30 L750,90 L0,90 Z"
            fill="#1565C0" opacity="0.85"/>
      <!-- Lighter accent wave -->
      <path d="M0,70 C100,40 220,90 360,60 C500,30 650,75 750,50 L750,90 L0,90 Z"
            fill="#0d47a1" opacity="0.6"/>
      <!-- Decorative dots -->
      <circle cx="40"  cy="72" r="4" fill="rgba(255,255,255,0.15)"/>
      <circle cx="70"  cy="60" r="2.5" fill="rgba(255,255,255,0.1)"/>
      <circle cx="700" cy="68" r="4" fill="rgba(255,255,255,0.15)"/>
      <circle cx="720" cy="55" r="2.5" fill="rgba(255,255,255,0.1)"/>
      <!-- Left accent bar -->
      <rect x="0" y="0" width="6" height="90" fill="#1565C0"/>
    </svg>

    <div class="footer-content">
      <p>Thank you for your business!<br><strong>{{brandName}}</strong></p>
      <p style="text-align:right">{{brandEmail}}<br><strong>{{brandPhone}}</strong></p>
    </div>
    {{{invoiceFooterBlock}}}
  </div>

</div><!-- /page -->
</body>
</html>
