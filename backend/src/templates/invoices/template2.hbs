<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{invoiceId}} - {{brandName}}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f3ea;
        --paper: #fffaf1;
        --ink: #1f2937;
        --muted: #6b7280;
        --line: #e5d8bf;
        --accent: #b45309;
        --accent-soft: #fff4de;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(180, 83, 9, 0.12), transparent 32%),
          linear-gradient(180deg, #fbf8f1 0%, var(--bg) 100%);
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
      }

      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 16mm;
      }

      .sheet {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 18px 50px rgba(120, 53, 15, 0.12);
        overflow: hidden;
      }

      .topbar {
        background: linear-gradient(135deg, #78350f 0%, #b45309 100%);
        color: #fff7ed;
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: start;
      }

      .topbar h1 {
        margin: 0 0 6px;
        font-size: 30px;
        line-height: 1;
      }

      .topbar p {
        margin: 4px 0;
        opacity: 0.95;
        font-size: 12px;
      }

      .badge {
        border: 1px solid rgba(255, 247, 237, 0.35);
        border-radius: 999px;
        padding: 6px 12px;
        display: inline-block;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .body {
        padding: 22px 24px 26px;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 18px;
      }

      .panel {
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 14px;
        background: rgba(255, 255, 255, 0.45);
      }

      .panel h2 {
        margin: 0 0 12px;
        font-size: 14px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .line {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 0;
        border-bottom: 1px dashed #e7dbc4;
        font-size: 13px;
      }

      .line:last-child {
        border-bottom: 0;
      }

      .label {
        color: var(--muted);
      }

      .value {
        font-weight: 700;
        text-align: right;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead th {
        background: var(--accent-soft);
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 11px;
        padding: 12px 10px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      tbody td {
        padding: 12px 10px;
        border-bottom: 1px solid #e9dfce;
        vertical-align: top;
        font-size: 13px;
      }

      .cell-center {
        text-align: center;
      }

      .cell-right {
        text-align: right;
        white-space: nowrap;
      }

      .item-title {
        font-weight: 700;
      }

      .item-meta {
        margin-top: 3px;
        color: var(--muted);
        font-size: 11px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr 290px;
        gap: 16px;
        margin-top: 16px;
      }

      .summary {
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.55);
      }

      .summary table td {
        padding: 10px 12px;
        font-size: 13px;
        border-bottom: 1px solid #eadfc7;
      }

      .summary table tr:last-child td {
        border-bottom: 0;
        background: #fff6e7;
        font-weight: 800;
      }

      .notes {
        border: 1px solid var(--line);
        border-left: 5px solid var(--accent);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.58);
        padding: 14px;
        min-height: 100%;
      }

      .notes-label {
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        font-weight: 700;
      }

      .notes-value {
        color: var(--ink);
        font-size: 13px;
        line-height: 1.6;
      }

      .stamp {
        margin-top: 14px;
        display: inline-block;
        border: 1px solid rgba(180, 83, 9, 0.4);
        color: var(--accent);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: #fff7ed;
      }

      @page {
        size: A4;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="sheet" style="position:relative;">
        {{{watermarkBlock}}}
        <img src="{{brandLogo}}" alt="Header Banner" style="width: 100%; height: auto; display: block;" onerror="this.style.display='none'" />
        <header class="topbar" style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div style="display: flex; align-items: flex-start; gap: 16px;">
            <div>
              <span class="badge" style="margin-bottom: 6px;">Invoice</span>
              <h1 style="margin: 0 0 4px; font-size: 24px;">{{brandName}}</h1>
              <p style="margin: 2px 0;">{{brandTagline}}</p>
              <p style="margin: 2px 0;">{{brandAddress}}</p>
              <p style="margin: 2px 0;">{{companyContactBlock}}</p>
              <p style="margin: 4px 0 0; font-size: 11px; opacity: 0.85;">{{brandLicenseBlock}}</p>
            </div>
          </div>
          <div style="text-align: right;">
            <div class="badge">{{safeTemplateName}}</div>
            <p style="margin-top: 12px; margin-bottom: 2px;">No. {{invoiceId}}</p>
            <p style="margin: 2px 0;">Date: {{createdAt}}</p>
            <p style="margin: 2px 0;">Status: {{invoiceStatus}}</p>
          </div>
        </header>

        <div class="body">
          <section class="grid">
            <div class="panel">
              <h2>Customer</h2>
              <div class="line"><span class="label">Name</span><span class="value">{{customerName}}</span></div>
              <div class="line"><span class="label">Phone</span><span class="value">{{customerPhone}}</span></div>
              <div class="line"><span class="label">Payment</span><span class="value">{{paymentMode}}</span></div>
            </div>

            <div class="panel">
              <h2>Quick Totals</h2>
              <div class="line"><span class="label">Items</span><span class="value">{{itemCount}}</span></div>
              <div class="line"><span class="label">Gross</span><span class="value">{{grossAmount}}</span></div>
              <div class="line"><span class="label">Total</span><span class="value">{{totalAmount}}</span></div>
            </div>
          </section>

          <section class="panel">
            <h2>Line Items</h2>
            <table>
              <thead>
                <tr>
                  <th style="width: 44px;">#</th>
                  <th>Item</th>
                  <th style="width: 68px;" class="cell-center">Qty</th>
                  <th style="width: 105px;" class="cell-right">Rate</th>
                  <th style="width: 105px;" class="cell-right">Discount</th>
                  <th style="width: 110px;" class="cell-right">Amount</th>
                </tr>
              </thead>
              <tbody>
                {{{itemsRows}}}
              </tbody>
            </table>
          </section>

          <section class="footer-grid">
            <div class="notes">
              <div class="notes-label">Notes</div>
              <div class="notes-value">{{notesValue}}</div>
              <div class="stamp">Template ready for Puppeteer PDF export</div>
            </div>

            <div class="summary">
              <table>
                <tbody>
                  {{{summaryRows}}}
                </tbody>
              </table>
            </div>
          </section>

          <!-- Terms and Footer Message -->
          <div style="margin: 16px 24px; border-top: 1px dashed var(--line); padding-top: 12px; font-size: 11px; color: var(--muted); font-family: sans-serif;">
            {{{invoiceTermsBlock}}}
            {{{invoiceFooterBlock}}}
          </div>
        </div>
        <img src="{{brandFooterImage}}" alt="Footer Banner" style="width: 100%; height: auto; display: block;" onerror="this.style.display='none'" />
      </section>
    </main>
  </body>
</html>
