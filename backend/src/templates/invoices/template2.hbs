<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{invoiceId}} - {{brandName}}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f8fafc;
        --paper: #ffffff;
        --ink: #0f172a;
        --muted: #64748b;
        --line: #e2e8f0;
        --accent: #0f172a;
        --accent-soft: #f1f5f9;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.4;
      }

      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 12mm;
      }

      .sheet {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        overflow: hidden;
      }

      .topbar {
        background: var(--accent);
        color: #ffffff;
        padding: 20px 24px;
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: flex-start;
      }

      .topbar h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.01em;
      }

      .topbar p {
        margin: 2px 0;
        opacity: 0.9;
        font-size: 12px;
      }

      .badge {
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 4px 10px;
        display: inline-block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .bill-container {
        height: 100%;
      }

      .body {
        padding: 24px;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
      }

      .panel {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 16px;
        background: var(--bg);
      }

      .panel h2 {
        margin: 0 0 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .line {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 0;
        border-bottom: 1px solid var(--line);
        font-size: 13px;
      }

      .line:last-child {
        border-bottom: 0;
      }

      .label {
        color: var(--muted);
      }

      .value {
        font-weight: 600;
        color: var(--ink);
        text-align: right;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead th {
        background: var(--accent-soft);
        color: var(--ink);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 11px;
        font-weight: 700;
        padding: 10px 12px;
        border-top: 1px solid var(--line);
        border-bottom: 2px solid var(--line);
      }

      tbody td {
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
        font-size: 13px;
        color: var(--ink);
      }

      .cell-center {
        text-align: center;
      }

      .cell-right {
        text-align: right;
        white-space: nowrap;
      }

      .item-title {
        font-weight: 600;
      }

      .item-meta {
        margin-top: 3px;
        color: var(--muted);
        font-size: 11px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1fr 290px;
        gap: 16px;
        margin-top: 20px;
      }

      .summary {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--bg);
        overflow: hidden;
      }

      .summary table td {
        padding: 8px 12px;
        font-size: 13px;
        border-bottom: 1px solid var(--line);
      }

      .summary table tr:last-child td {
        border-bottom: 0;
        background: var(--accent);
        color: #ffffff;
        font-weight: 700;
      }

      .notes {
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        border-radius: 10px;
        background: var(--bg);
        padding: 14px;
        min-height: 100%;
      }

      .notes-label {
        margin-bottom: 6px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        font-weight: 700;
      }

      .notes-value {
        color: var(--ink);
        font-size: 13px;
        line-height: 1.5;
      }

      .stamp {
        margin-top: 12px;
        display: inline-block;
        border: 1px solid var(--line);
        color: var(--muted);
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: #ffffff;
      }

      @page {
        size: A4;
        margin: 0;
      }
    </style>
    {{{halfPrintStyles}}}
  </head>
  <body>
    <main class="page bill-container">
      <section class="sheet" style="position:relative;">
        {{{watermarkBlock}}}
        {{#if brandLogo}}
          <div class="header-image-wrapper" style="background: #ffffff; text-align: center; border-bottom: 1px solid var(--line);">
            <img
              src="{{brandLogo}}"
              alt="{{brandName}} Header"
              style="width: 100%; max-height: 160px; object-fit: contain; display: block;"
              onerror="this.parentElement.style.display='none';"
            />
          </div>

          <header
            class="topbar"
            style="display: flex; justify-content: space-between; align-items: center; padding: 12px 24px;"
          >
            <div>
              <span class="badge" style="margin-right: 8px;">Invoice No. {{invoiceId}}</span>
              <span class="badge">Status: {{invoiceStatus}}</span>
            </div>
            <div style="text-align: right; font-size: 13px;">
              <p style="margin: 0; font-weight: 600;">Date: {{createdAt}}</p>
            </div>
          </header>
        {{else}}
          <header
            class="topbar"
            style="display: flex; justify-content: space-between; align-items: flex-start;"
          >
            <div style="display: flex; align-items: flex-start; gap: 16px;">
              <div>
                <span class="badge" style="margin-bottom: 6px;">Tax Invoice</span>
                <h1 style="margin: 4px 0 4px; font-size: 24px;">{{brandName}}</h1>
                {{#if brandTagline}}<p style="margin: 2px 0;">{{brandTagline}}</p>{{/if}}
                {{#if brandAddress}}<p style="margin: 2px 0;">{{brandAddress}}</p>{{/if}}
                {{#if companyContactBlock}}<p style="margin: 2px 0;">{{companyContactBlock}}</p>{{/if}}
                {{#if brandLicenseBlock}}
                  <p
                    style="margin: 4px 0 0; font-size: 11px; opacity: 0.85;"
                  >{{brandLicenseBlock}}</p>
                {{/if}}
              </div>
            </div>
            <div style="text-align: right;">
              <div class="badge">Invoice No. {{invoiceId}}</div>
              <p style="margin-top: 10px; margin-bottom: 2px;">Date: {{createdAt}}</p>
              <p style="margin: 2px 0;">Status: {{invoiceStatus}}</p>
            </div>
          </header>
        {{/if}}

        <div class="body">
          <section class="grid">
            <div class="panel">
              <h2>Customer Information</h2>
              <div class="line"><span class="label">Name</span><span
                  class="value"
                >{{customerName}}</span></div>
              <div class="line"><span class="label">Phone</span><span
                  class="value"
                >{{customerPhone}}</span></div>
              <div class="line"><span class="label">Payment Mode</span><span
                  class="value"
                >{{paymentMode}}</span></div>
            </div>

            <div class="panel">
              <h2>Invoice Summary</h2>
              <div class="line"><span class="label">Total Items</span><span
                  class="value"
                >{{itemCount}}</span></div>
              <div class="line"><span class="label">Subtotal</span><span
                  class="value"
                >{{grossAmount}}</span></div>
              <div class="line"><span class="label">Net Amount</span><span
                  class="value"
                >{{totalAmount}}</span></div>
            </div>
          </section>

          <section class="panel table-container" style="padding: 0; overflow: hidden;">
            <table style="margin: 0;">
              <thead>
                <tr>
                  <th style="width: 44px;">#</th>
                  <th>Item Description</th>
                  <th style="width: 68px;" class="cell-center">Qty</th>
                  <th style="width: 105px;" class="cell-right">Rate</th>
                  <th style="width: 105px;" class="cell-right">Discount</th>
                  <th style="width: 110px;" class="cell-right">Amount</th>
                </tr>
              </thead>
              <tbody>
                {{{itemsRows}}}
              </tbody>
            </table>
          </section>

          <section class="footer-grid bottom-blocks-grid">
            <div class="notes">
              <div class="notes-label">Notes & Remarks</div>
              <div class="notes-value">{{notesValue}}</div>
              <div class="stamp">Official Invoice Record</div>
            </div>

            <div class="summary">
              <table>
                <tbody>
                  {{{summaryRows}}}
                </tbody>
              </table>
            </div>
          </section>

          {{#if invoiceTermsBlock}}
            <div
              class="terms-conditions-wrapper"
              style="margin-top: 20px; border-top: 1px solid var(--line); padding-top: 12px; font-size: 11px; color: var(--muted);"
            >
              {{{invoiceTermsBlock}}}
            </div>
          {{/if}}

          {{#if brandFooterImage}}
            <div style="margin-top: 16px;">
              <img
                src="{{brandFooterImage}}"
                alt="Footer Banner"
                style="width: 100%; max-height: 80px; object-fit: contain; display: block;"
                onerror="this.style.display='none'"
              />
            </div>
          {{/if}}
        </div>
      </section>
    </main>
  </body>
</html>